# Copy to .env. Use one provider's key and exact model ID together.
# Providers: openai, gemini, deepseek, qwen, custom
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite

# Leave blank for a provider preset. Required for custom.
# Qwen defaults to Singapore; use your account region's endpoint if different.
AI_BASE_URL=

# Set false only if your compatible endpoint does not support JSON mode.
AI_JSON_MODE=true

# OpenAI example: AI_PROVIDER=openai and AI_MODEL=gpt-4o-mini
# DeepSeek / Qwen: use the exact model ID shown in your provider's console.
# Other providers must support the OpenAI-compatible Chat Completions API.
# Existing OPENAI_API_KEY / OPENAI_MODEL settings still work for openai.
# Provider-specific GEMINI_*, DEEPSEEK_* and QWEN_* variables also work
# when the corresponding generic AI_API_KEY / AI_MODEL fields are blank.
